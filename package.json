{
  "name": "ym-launcher",
  "productName": "Ym Launcher",
  "version": "2.2.0",
  "description": "A modern and customizable Windows application launcher",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Mingyang Zhang",
    "email": "2514765066@qq.com",
    "url": "https://github.com/2514765066"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2514765066/ym-launcher.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 &&  electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "rebuild": "electron-rebuild -f -w extract-file-icon",
    "format": "prettier . --write",
    "release": "tsx ./scripts/publish.ts"
  },
  "dependencies": {
    "extract-file-icon": "^0.3.2",
    "sharp": "^0.35.3",
    "uiohook-napi": "^1.5.5",
    "wallpaper": "^7.3.1",
    "ym-fullscreen-detector": "^0.1.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@lucide/vue": "^1.25.0",
    "@tailwindcss/vite": "^4.2.3",
    "@types/node": "^26.1.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "nanoid": "^6.0.0",
    "node-abi": "^4.33.0",
    "pinia": "^4.0.2",
    "pinyin": "^4.0.0",
    "plugin-electron-ipc": "^0.1.2",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.1",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.2.0",
    "vue": "^3.5.25",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.1.6",
    "ym-release": "^2.0.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  }
}
